# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# You can run and read the whole song page with only the first three values.
# The model provider is needed ONLY by the rendering-backfill job.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://lyricsense:lyricsense@localhost:5432/lyricsense
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-any-random-string-locally

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Grounding (D-003) ───────────────────────────────────────────────────────
# The four-source bar. Configuration, never a constant — see research.md R-04.
GROUNDING_MIN_SOURCES=4

# Above this many lines the page switches to windowed loading (research.md R-03).
LINE_WINDOWING_THRESHOLD=150

# ── Google login ────────────────────────────────────────────────────────────
# Optional locally: signed-out visitors can read song pages (research.md R-09).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Model provider ──────────────────────────────────────────────────────────
# Only the rendering-backfill job calls a model. `ollama` needs no key and keeps
# development quota-free; `gemini` needs a key from Google AI Studio.
LLM_PROVIDER=ollama
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Per-job model choice (tech_stack.md) — these are NOT one setting.
LLM_MODEL_RENDERING=gemini-2.5-flash

# ── Rate limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_READ_PER_MINUTE=600
RATE_LIMIT_MODEL_PER_MINUTE=10
